{
  "manifest_version": 3,
  "name": "EchoGPT — AI Workspace",
  "version": "1.0.0",
  "description": "A focused workspace for writing, reading, translating, and AI tools. Frontend concept with demo responses.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open EchoGPT", "default_popup": "index.html?surface=popup" },
  "side_panel": { "default_path": "index.html?surface=sidepanel" },
  "options_page": "index.html#/settings",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
